{
  "name": "pi-context-preload",
  "version": "0.1.1",
  "private": true,
  "description": "Preload pi chat context from file globs in CONTEXT_PRELOAD.yml.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "biome check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "node --experimental-strip-types --test test/e2e.test.ts",
    "test:unit": "node --experimental-strip-types --test test/unit.test.ts",
    "typecheck": "tsc"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "globby": "16.2.4",
    "p-map": "7.0.7",
    "read-yaml-file": "3.0.0",
    "typebox": "1.3.30"
  }
}
