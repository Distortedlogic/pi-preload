{
	"name": "pi-preload",
	"version": "0.2.0",
	"private": true,
	"description": "Preload pi chat context from AGENTS.yml file globs.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"lint": "biome check .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "node --import tsx --test test/e2e.test.ts",
		"test:unit": "node --import tsx --test test/unit.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"context",
		"grit",
		"skills",
		"presets"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": ">=0.85.1 <1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.19.0",
		"@types/nunjucks": "3.2.6",
		"tsx": "4.23.13",
		"typescript": "~7.0.2"
	},
	"dependencies": {
		"@getgrit/gritql": "0.0.3",
		"file-type": "22.1.0",
		"isbinaryfile": "5.0.0",
		"nunjucks": "3.2.4",
		"p-map": "7.0.7",
		"pi-agents-yaml": "github:Distortedlogic/pi-agents-yaml#main"
	}
}
