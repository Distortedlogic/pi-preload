{
	"name": "pi-preload",
	"version": "0.2.5",
	"private": true,
	"description": "Preload generated and preset-selected Pi chat context from AGENTS.yml.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"lint": "biome check .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "node --import tsx --test test/e2e.test.ts",
		"test:unit": "node --import tsx --test test/unit.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"context",
		"skills"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "0.87.0",
		"@earendil-works/pi-coding-agent": "0.87.0",
		"typebox": "1.3.34"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "22.19.0",
		"@types/nunjucks": "3.2.6",
		"tsx": "4.23.15",
		"typebox": "1.3.34",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"file-type": "22.1.0",
		"nunjucks": "3.2.4",
		"p-map": "7.0.7",
		"pi-agents-yaml": "github:Distortedlogic/pi-agents-yaml#4186ca521725ff8db4ca5abb083dd900ee222bba",
		"pi-read-signatures": "github:Distortedlogic/pi-read-signatures#3b36ffe75011d11d9512bf614865857e26ff329e"
	}
}
